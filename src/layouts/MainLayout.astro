---
interface Props { title?: string }
const { title = 'Цифровая география — интерактивные работы' } = Astro.props;
---
<!doctype html>
<html lang="ru" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="Интерактивные практические работы и географическая номенклатура для 6–11 классов." />
  <meta name="theme-color" content="#6749cf" />
  <title>{title}</title>
  <link rel="icon" href="./assets/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="./manifest.webmanifest" />
  <link rel="apple-touch-icon" href="./assets/icons/icon-192.png" />
  <link rel="stylesheet" href="./assets/styles.css" />
  <script is:inline src="./assets/app.js" defer></script>
  <script is:inline src="./assets/pwa.js" defer></script>
</head>
<body><slot /></body>
</html>
