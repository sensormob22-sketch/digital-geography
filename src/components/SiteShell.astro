---
import catalog from '../data/catalog.json';
import SideNav from './SideNav.astro';
import TopNav from './TopNav.astro';
import UpdatesBanner from './UpdatesBanner.astro';
import NotReadyDialog from './NotReadyDialog.astro';
---

<script is:inline id="geoCatalog" type="application/json" set:html={JSON.stringify(catalog)}></script>
<script is:inline>window.GEO_CATALOG=JSON.parse(document.getElementById('geoCatalog').textContent);</script>

<div id="app" class="app-shell">
  <div class="overlay" id="menuOverlay" hidden></div>
  <SideNav />
  <div class="main-area">
    <TopNav />
    <main id="pageContent" class="page-content" tabindex="-1"></main>
  </div>
</div>
<UpdatesBanner />
<NotReadyDialog />
